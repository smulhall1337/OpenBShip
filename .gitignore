# Track only the current source and the scripts/manifests needed to launch it.
*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/Setup.ps1
!/Build.ps1
!/Launch.cmd
!/src/
!/src/*.cs
!/scripts/
!/scripts/*.ps1
!/scripts/assets.csv
!/scripts/programs.csv

# Generated builds, original media, settings, research and comparison packages.
/build/
/outputs/
/work/
