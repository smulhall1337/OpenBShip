@echo off
setlocal
set "BATTLESHIP_REG_BACKUP=%~dp0..\work\reference-logs\registry-before-first-setup.json"
powershell.exe -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; $base=$null; $key=$null; try { if (!(Test-Path -LiteralPath $env:BATTLESHIP_REG_BACKUP)) { Write-Host 'No saved registry settings to restore.'; exit 0 }; $saved=Get-Content -LiteralPath $env:BATTLESHIP_REG_BACKUP -Raw | ConvertFrom-Json; $base=[Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine,[Microsoft.Win32.RegistryView]::Registry32); $subkey='SOFTWARE\Hasbro_Interactive\Battleship'; $key=$base.OpenSubKey($subkey,$true); if (!$key -and $saved.KeyExisted) { $key=$base.CreateSubKey($subkey) }; if ($key) { foreach ($entry in $saved.Values) { if ($entry.Existed) { $kind=[Microsoft.Win32.RegistryValueKind]$entry.Kind; $value=$entry.Value; switch ($entry.Kind) { 'Binary' { $value=[byte[]]$value }; 'MultiString' { $value=[string[]]$value }; 'DWord' { $value=[int]$value }; 'QWord' { $value=[long]$value } }; $key.SetValue($entry.Name,$value,$kind) } else { $key.DeleteValue($entry.Name,$false) } }; $remove=(!$saved.KeyExisted -and $key.ValueCount -eq 0 -and $key.SubKeyCount -eq 0); $key.Dispose(); $key=$null; if ($remove) { $base.DeleteSubKey($subkey,$false) } }; Move-Item -LiteralPath $env:BATTLESHIP_REG_BACKUP -Destination ($env:BATTLESHIP_REG_BACKUP+'.restored-'+[guid]::NewGuid().ToString('N')); Write-Host 'Restored the six Battleship resource settings.'; exit 0 } catch { Write-Host ('Restore failed: '+$_.Exception.Message); Write-Host 'If access was denied, run this restore command as administrator.'; exit 1 } finally { if ($key) { $key.Dispose() }; if ($base) { $base.Dispose() } }"
set "result=%errorlevel%"
pause
exit /b %result%
